# Copy to .env and fill in. Never commit/ship the real .env.
# Get these from https://dashboard.ngrok.com  (Authtoken + optional reserved Domain)

NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional. Set to a reserved ngrok domain for a FIXED public URL.
# Leave empty to get a random quick-tunnel URL each start.
NGROK_DOMAIN=
